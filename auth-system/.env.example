# Supabase Configuration
# Required: The base URL of your Supabase PostgreSQL project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Required: The server-only service-role key for backend database operations
# Keep this private. Never expose to client-side code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Session Security
# Required: High-entropy secret key used to sign and verify HS256 authentication tokens
# Must be at least 32 characters long.
JWT_SECRET=your-strong-random-jwt-secret-at-least-32-chars
